<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#003FB1</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F8F9FF</item>
        <item name="android:navigationBarColor">#F8F9FF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F8F9FF</item>
        <!-- Every AlertDialog in the app picks up the modern look below. -->
        <item name="android:alertDialogTheme">@style/AppAlertDialog</item>
    </style>
    <style name="AppAlertDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowElevation">16dp</item>
        <item name="android:colorAccent">#003FB1</item>
        <item name="android:textColorPrimary">#0B1C30</item>
        <item name="android:textColorSecondary">#434654</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowTitleStyle">@style/AppDialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
    </style>
    <style name="AppDialogTitle" parent="android:TextAppearance.Material.DialogWindowTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#0B1C30</item>
    </style>
    <style name="AppDialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#003FB1</item>
        <item name="android:minWidth">72dp</item>
    </style>
    <style name="SheetAnimation">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
    <style name="FieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#24334F</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="TextField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/field_background</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#13213C</item>
        <item name="android:textColorHint">#738096</item>
        <item name="android:singleLine">true</item>
        <item name="android:saveEnabled">false</item>
    </style>
</resources>
