<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#F8F9FF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="28dp">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_brand" android:importantForAccessibility="no"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:text="@string/brand" android:textSize="12sp" android:letterSpacing="0.14" android:fontFamily="sans-serif-medium" android:textColor="#003FB1"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/welcome" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:textColor="#13213C" android:accessibilityHeading="true"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/subtitle" android:textSize="16sp" android:textColor="#63728A"/>
            <TextView style="@style/FieldLabel" android:layout_marginTop="32dp" android:text="@string/email_label" android:labelFor="@id/email"/>
            <EditText android:id="@+id/email" style="@style/TextField" android:hint="@string/email_hint"
                android:inputType="text" android:autofillHints="username" android:imeOptions="actionNext"/>
            <TextView style="@style/FieldLabel" android:layout_marginTop="20dp" android:text="@string/password_label" android:labelFor="@id/password"/>
            <EditText android:id="@+id/password" style="@style/TextField" android:hint="@string/password_hint"
                android:inputType="textPassword" android:autofillHints="password" android:imeOptions="actionDone"/>
            <CheckBox android:id="@+id/show_password" android:layout_width="wrap_content" android:layout_height="48dp"
                android:text="@string/show_password" android:textSize="14sp" android:textColor="#4E5E78" android:saveEnabled="false"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp">
                <Button android:id="@+id/sign_in" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/button_background" android:backgroundTint="@null"
                    android:text="@string/sign_in" android:textAllCaps="false" android:textSize="17sp" android:textColor="#FFFFFF"/>
                <ProgressBar android:id="@+id/sign_in_progress" android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end" android:layout_marginEnd="20dp"
                    android:indeterminateTint="#FFFFFF" android:visibility="gone"/>
            </FrameLayout>
            <Button android:id="@+id/help" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="8dp" android:text="@string/help" android:textAllCaps="false" android:textSize="14sp" android:textColor="#003FB1"/>
            <Space android:layout_width="match_parent" android:layout_height="24dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
